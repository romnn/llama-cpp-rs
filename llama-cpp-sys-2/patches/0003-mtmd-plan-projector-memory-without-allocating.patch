+// Projection scopes are synchronous and thread-local, so concurrent loads keep their own totals.
+// Keep this source-only: the public and binding-visible headers retain upstream's ABI.
+static thread_local std::map<ggml_backend_dev_t, size_t> * mtmd_projected_compute = nullptr;
+
+std::map<ggml_backend_dev_t, size_t> mtmd_measure_compute(const std::function<void()> & prepare);
+std::map<ggml_backend_dev_t, size_t> mtmd_measure_compute(const std::function<void()> & prepare) {
+    std::map<ggml_backend_dev_t, size_t> sizes;
+    struct projection_scope {
+        std::map<ggml_backend_dev_t, size_t> * previous;
+        ~projection_scope() { mtmd_projected_compute = previous; }
+    } scope{std::exchange(mtmd_projected_compute, &sizes)};
+    prepare();
+    return sizes;
+}
+
 mtmd_subcontext::support_info_graph mtmd_subcontext::reserve_compute_meta(const mtmd_image_f32_batch & batch) {
     ggml_cgraph * gf = mtmd_get_graph_builder(this, batch)->build();
-    ggml_backend_sched_reserve(backends.sched.get(), gf);
+    if (mtmd_projected_compute) {
+        std::vector<size_t> sizes(backends.ptrs.size(), 0);
+        ggml_backend_sched_reserve_size(backends.sched.get(), gf, sizes.data());
+        std::map<ggml_backend_dev_t, size_t> per_device;
+        for (size_t i = 0; i < sizes.size(); ++i) {
+            per_device[ggml_backend_get_device(backends.ptrs[i])] += sizes[i];
+        }
+        // Subcontexts reuse one scheduler, so reserve the largest graph rather than their sum.
+        for (const auto & [device, size] : per_device) {
+            auto & peak = (*mtmd_projected_compute)[device];
+            peak = std::max(peak, size);
+        }
+    } else if (!ggml_backend_sched_reserve(backends.sched.get(), gf)) {
+        throw std::runtime_error(mtmd_format("%s: failed to allocate compute buffers", __func__));
+    }

     const int n_splits = ggml_backend_sched_get_n_splits(backends.sched.get());
     const int n_nodes  = ggml_graph_n_nodes(gf);
