 // API for debugging
 //
diff --git a/tools/mtmd/mtmd.cpp b/tools/mtmd/mtmd.cpp
index 2efa4d6..7e31ee4 100644
--- a/tools/mtmd/mtmd.cpp
+++ b/tools/mtmd/mtmd.cpp
@@ -2701,6 +2701,30 @@ static void stub_log_callback(enum ggml_log_level, const char *, void *) {
     // do nothing
 }
 
+// Defined in clip.cpp. Declared here because downstream patches may not change clip.h.
+std::map<ggml_backend_dev_t, size_t> clip_get_compute_usage(struct clip_ctx * ctx, const clip_image_f32_batch * imgs);
+
+// Projects the compute buffers encoding `chunk` with `ctx` needs, per backend device, without
+// allocating them. Returns an empty map for a text chunk and when the projection fails.
+MTMD_API std::map<ggml_backend_dev_t, size_t> mtmd_get_chunk_compute_usage(mtmd_context * ctx,
+                                                                         const mtmd_input_chunk * chunk);
+MTMD_API std::map<ggml_backend_dev_t, size_t> mtmd_get_chunk_compute_usage(mtmd_context * ctx,
+                                                                         const mtmd_input_chunk * chunk) {
+    try {
+        if (chunk->type == MTMD_INPUT_CHUNK_TYPE_IMAGE && ctx->ctx_v && chunk->tokens_image &&
+                !chunk->tokens_image->is_placeholder()) {
+            return clip_get_compute_usage(ctx->ctx_v, &chunk->tokens_image->batch_f32);
+        }
+        if (chunk->type == MTMD_INPUT_CHUNK_TYPE_AUDIO && ctx->ctx_a && chunk->tokens_audio &&
+                !chunk->tokens_audio->is_placeholder()) {
+            return clip_get_compute_usage(ctx->ctx_a, &chunk->tokens_audio->batch_f32);
+        }
+    } catch (const std::exception & e) {
+        LOG_ERR("%s: error: %s\n", __func__, e.what());
+    }
+    return {};
+}
+
 std::map<ggml_backend_dev_t, size_t> mtmd_get_memory_usage(const char * mmproj_fname,
                                                             struct mtmd_context_params ctx_params) {
     mtmd::context_ptr ctx;
