From: Airtype downstream
Subject: [PATCH] cuda: bypass miscompiled IQ_S kernels with CUDA 13.2

CUDA 13.2 miscompiles the lookup-table MMQ and MMVQ kernels for IQ1_S,
IQ2_S, and IQ3_S. Keep CUDA selected but route these formats through the
correct generic CUDA paths when compiling with exactly CUDA 13.2. CUDA 13.3
fixes the compiler regression.

Upstream reports:
https://github.com/ggml-org/llama.cpp/issues/21255
https://github.com/ggml-org/llama.cpp/issues/21371

Validated on an NVIDIA GeForce RTX 5060 Ti against llama.cpp b10121:
- CUDA 13.2 fails the affected backend operation tests and Qwen3.6 27B IQ2_M.
- CUDA 13.0 and CUDA 13.3 pass without the fallback.
- CUDA 13.2 passes with this fallback.

diff --git a/ggml/src/ggml-cuda/common.cuh b/ggml/src/ggml-cuda/common.cuh
index fa2dd2620..c3d778a8b 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -63,6 +63,18 @@
 #define GGML_CUDA_CC_OFFSET_MTHREADS 0x0100000
 #define GGML_CUDA_CC_IS_NVIDIA(cc)   (cc < GGML_CUDA_CC_OFFSET_MTHREADS)
 
+// CUDA 13.2 miscompiles the lookup-table MMQ/MMVQ kernels for these formats and produces incorrect results.
+// CUDA 13.3 fixes the compiler regression: https://github.com/ggml-org/llama.cpp/issues/21371
+static constexpr bool ggml_cuda_compiler_miscompiles_iq_s(enum ggml_type type) {
+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA) && defined(__CUDACC_VER_MAJOR__) && defined(__CUDACC_VER_MINOR__) && \
+    __CUDACC_VER_MAJOR__ == 13 && __CUDACC_VER_MINOR__ == 2
+    return type == GGML_TYPE_IQ1_S || type == GGML_TYPE_IQ2_S || type == GGML_TYPE_IQ3_S;
+#else
+    GGML_UNUSED(type);
+    return false;
+#endif
+}
+
 // AMD
 // GCN/CDNA, wave size is 64
 #define GGML_CUDA_CC_GCN4       (GGML_CUDA_CC_OFFSET_AMD + 0x803)  // Tonga, Fiji, Polaris, minimum for fast fp16
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index e73a7b890..6ffaa399b 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -1790,7 +1790,8 @@ static bool ggml_cuda_should_fuse_mul_mat_vec_q(const ggml_tensor * tensor) {
                                    src0->view_src;
 
     bool use_mul_mat_vec_q = ggml_is_quantized(src0->type) && !bad_padding_clear && src1->type == GGML_TYPE_F32 &&
-                             dst->type == GGML_TYPE_F32 && src1->ne[1] <= MMVQ_MAX_BATCH_SIZE;
+                             dst->type == GGML_TYPE_F32 && src1->ne[1] <= MMVQ_MAX_BATCH_SIZE &&
+                             !ggml_cuda_compiler_miscompiles_iq_s(src0->type);
 
     // fusion is not universally faster on Pascal
     const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
diff --git a/ggml/src/ggml-cuda/mmq.cu b/ggml/src/ggml-cuda/mmq.cu
index 8a0f4d3b5..e90f9e52b 100644
--- a/ggml/src/ggml-cuda/mmq.cu
+++ b/ggml/src/ggml-cuda/mmq.cu
@@ -254,6 +254,10 @@ void ggml_cuda_mul_mat_q(
 }
 
 bool ggml_cuda_should_use_mmq(enum ggml_type type, int cc, int64_t ne11, int64_t n_experts) {
+    if (ggml_cuda_compiler_miscompiles_iq_s(type)) {
+        return false;
+    }
+
 #ifdef GGML_CUDA_FORCE_CUBLAS
     return false;
 #endif // GGML_CUDA_FORCE_CUBLAS
diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index e18ada537..c718cb2ac 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -245,6 +245,10 @@ static constexpr __host__ __device__ int get_mmvq_mmid_max_batch_rdna4(ggml_type
 
 // Host function: returns the max batch size for the current arch+type at runtime.
 int get_mmvq_mmid_max_batch(ggml_type type, int cc) {
+    if (ggml_cuda_compiler_miscompiles_iq_s(type)) {
+        return 0;
+    }
+
     // NVIDIA: Volta, Ada Lovelace, and Blackwell always use MMVQ for MUL_MAT_ID.
     if (GGML_CUDA_CC_IS_NVIDIA(cc)) {
         if (cc == GGML_CUDA_CC_VOLTA || cc >= GGML_CUDA_CC_ADA_LOVELACE) {
@@ -278,6 +282,10 @@ int get_mmvq_mmid_max_batch(ggml_type type, int cc) {
 }
 
 bool ggml_cuda_should_use_mmvq(enum ggml_type type, int cc, int64_t ne11) {
+    if (ggml_cuda_compiler_miscompiles_iq_s(type)) {
+        return false;
+    }
+
     if (!ggml_is_quantized(type)) {
         return false;
     }
